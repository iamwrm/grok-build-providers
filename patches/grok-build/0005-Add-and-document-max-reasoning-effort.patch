+    #[test]
+    fn resolve_effort_token_max_downgrades_to_xhigh_unless_offered() {
+        // Menu with a real Max level (Codex gpt-5.6 style): `max` is distinct.
+        let with_max = state_with_meta(Some(serde_json::json!({
+            "supportsReasoningEffort": true,
+            "reasoningEfforts": [
+                { "value": "xhigh", "label": "Extra high" },
+                { "value": "max", "label": "Max" },
+            ],
+        })));
+        assert_eq!(
+            with_max.resolve_effort_token("max"),
+            Some(ReasoningEffort::Max)
+        );
+        assert_eq!(
+            with_max.resolve_effort_token("xhigh"),
+            Some(ReasoningEffort::Xhigh)
+        );
+
+        // Menu topping out at xhigh: `max` keeps its historical alias
+        // behavior and downgrades instead of newly erroring.
+        let without_max = state_with_meta(Some(serde_json::json!({
+            "supportsReasoningEffort": true,
+            "reasoningEfforts": [
+                { "value": "high", "label": "High" },
+                { "value": "xhigh", "label": "Extra high" },
+            ],
+        })));
+        assert_eq!(
+            without_max.resolve_effort_token("max"),
+            Some(ReasoningEffort::Xhigh)
+        );
+
+        // Legacy built-in menu (no server list) also downgrades.
+        let legacy = state_with_meta(Some(serde_json::json!({
+            "supportsReasoningEffort": true,
+        })));
+        assert_eq!(
+            legacy.resolve_effort_token("max"),
+            Some(ReasoningEffort::Xhigh)
+        );
+
+        // No xhigh either → still rejected (no silent multi-step downgrade).
+        let low_only = state_with_meta(Some(serde_json::json!({
+            "supportsReasoningEffort": true,
+            "reasoningEfforts": [{ "value": "low", "label": "Low" }],
+        })));
+        assert!(low_only.resolve_effort_token("max").is_none());
+    }
