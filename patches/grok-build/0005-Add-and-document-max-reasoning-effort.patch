-            .map(|o| o.value)
+        if let Some(option) = options.iter().find(|opt| opt.value == parsed) {
+            return Some(option.value);
+        }
+        // `max` was historically a UX alias of xhigh; on models whose menu
+        // does not offer a real Max level, keep that behavior by downgrading
+        // to an offered Xhigh instead of newly rejecting the token.
+        if parsed == ReasoningEffort::Max {
+            return options
+                .iter()
+                .find(|opt| opt.value == ReasoningEffort::Xhigh)
+                .map(|o| o.value);
+        }
+        None
     }
 
