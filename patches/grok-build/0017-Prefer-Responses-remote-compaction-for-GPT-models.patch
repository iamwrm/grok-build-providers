+#[derive(Debug, Default)]
+struct RemoteCompactionV2Collector {
+    output_item_done: Vec<ResponsesCompactionItem>,
+    terminal_output: Vec<ResponsesCompactionItem>,
+}
+
+type SharedRemoteCompactionV2Collector =
+    std::sync::Arc<std::sync::Mutex<RemoteCompactionV2Collector>>;
+
+fn is_compaction_wire_item(value: &serde_json::Value) -> bool {
+    matches!(
+        value.get("type").and_then(serde_json::Value::as_str),
+        Some("compaction" | "compaction_summary")
+    )
+}
+
+fn record_remote_compaction_item(
+    collector: &SharedRemoteCompactionV2Collector,
+    value: &serde_json::Value,
+    terminal: bool,
+) {
+    let Some(item) = ResponsesCompactionItem::from_wire_value(value) else {
+        return;
+    };
+    let mut collector = collector
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    if terminal {
+        collector.terminal_output.push(item);
+    } else {
+        collector.output_item_done.push(item);
+    }
+}
+
+/// Collect and remove output-only compaction items before handing an event to
+/// async-openai, whose pinned event model does not know the v2 item type.
+/// Returns `true` when the entire event is an item lifecycle notification that
+/// should be swallowed.
+fn collect_remote_compaction_v2_event(
+    value: &mut serde_json::Value,
+    collector: &SharedRemoteCompactionV2Collector,
+) -> bool {
+    if value.get("item").is_some_and(is_compaction_wire_item) {
+        if value.get("type").and_then(serde_json::Value::as_str)
+            == Some("response.output_item.done")
+            && let Some(item) = value.get("item")
+        {
+            record_remote_compaction_item(collector, item, false);
+        }
+        return true;
+    }
+
+    if let Some(output) = value
+        .pointer_mut("/response/output")
+        .and_then(serde_json::Value::as_array_mut)
+    {
+        output.retain(|item| {
+            if is_compaction_wire_item(item) {
+                record_remote_compaction_item(collector, item, true);
+                false
+            } else {
+                true
+            }
+        });
+    }
+    false
+}
