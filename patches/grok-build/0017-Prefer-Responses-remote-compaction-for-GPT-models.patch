+/// Whether this model should optimistically try Responses remote compaction
+/// v2 before the portable summarizer. The protocol is Responses-only; model
+/// matching is deliberately capability-by-convention so configured GPT
+/// passthrough routes can try it and fall back cleanly when unsupported.
+pub(crate) fn should_try_remote_compaction_v2(config: &SamplingConfig) -> bool {
+    config.api_backend == ApiBackend::Responses && config.model.to_ascii_lowercase().contains("gpt")
+}
+
+/// Ask the active Responses provider for one opaque remote-compaction v2
+/// checkpoint. This sends the ordinary active request shape and tools, with a
+/// final `compaction_trigger`; callers own fallback to portable compaction.
+pub(crate) async fn generate_remote_session_compact(
+    chat_history: Vec<ConversationItem>,
+    tools: Vec<ToolSpec>,
+    hosted_tools: Vec<HostedTool>,
+    client: OaiCompatClient,
+    session_id: acp::SessionId,
+    sampling_config: &SamplingConfig,
+    idle_timeout: std::time::Duration,
+) -> Result<ResponsesCompactionItem, SamplingError> {
+    let has_tools = !tools.is_empty();
+    let session_id = session_id.to_string();
+    let request = ConversationRequest {
+        items: chat_history,
+        tool_choice: has_tools.then_some(ConversationToolChoice::Auto),
+        tools,
+        hosted_tools,
+        model: Some(sampling_config.model.to_owned()),
+        x_grok_conv_id: Some(session_id.clone()),
+        x_grok_req_id: Some(format!("xai-remote-compact-{}", uuid::Uuid::new_v4())),
+        x_grok_session_id: Some(session_id.clone()),
+        x_grok_agent_id: Some(xai_grok_telemetry::id::agent_id()),
+        reasoning_effort: sampling_config.reasoning_effort,
+        prompt_cache_key: Some(session_id),
+        ..Default::default()
+    };
+    client
+        .conversation_compact_responses_v2(request, idle_timeout)
+        .await
+}
+
