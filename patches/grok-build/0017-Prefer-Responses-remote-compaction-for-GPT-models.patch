+    /// Render and clear a deferred compaction completion. Auto-compaction
+    /// flushes this at turn end after the provider confirms context usage;
+    /// manual `/compact` flushes it when the command response arrives.
+    pub fn flush_pending_compaction(&mut self, scrollback: &mut ScrollbackState) -> bool {
+        let Some(pending) = self.pending_compaction.take() else {
+            return false;
+        };
+        scrollback.push_block(RenderBlock::session_event(
+            SessionEvent::CompactionCompleted {
+                tokens_before: pending.tokens_before,
+                tokens_after: pending.last_used.unwrap_or(pending.estimate_after),
