--- a/crates/codegen/xai-grok-pager/src/acp/model_state.rs
+++ b/crates/codegen/xai-grok-pager/src/acp/model_state.rs
@@ -189,10 +189,23 @@ impl ModelState {
             return Some(option.value);
         }
         let parsed = token.parse::<ReasoningEffort>().ok()?;
+        if options.iter().any(|option| option.value == parsed) {
+            return Some(parsed);
+        }
+
+        // Provider menus can expose only one side of the two highest levels:
+        // OpenAI models without native `max` accept `xhigh`, while some
+        // Anthropic models expose `max` but no distinct `xhigh`. Keep the
+        // user's intent at the strongest supported neighboring level.
+        let compatible = match parsed {
+            ReasoningEffort::Max => ReasoningEffort::Xhigh,
+            ReasoningEffort::Xhigh => ReasoningEffort::Max,
+            _ => return None,
+        };
         options
             .iter()
-            .find(|opt| opt.value == parsed)
-            .map(|o| o.value)
+            .any(|option| option.value == compatible)
+            .then_some(compatible)
     }
 
