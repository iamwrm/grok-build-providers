+++ b/crates/codegen/xai-grok-shell/src/agent/config/provider_catalogs.rs
@@ -0,0 +1,274 @@
+//! Built-in catalogs for consumer-plan OAuth providers.
+//!
+//! Entries are visible only after the matching provider login succeeds. They
+//! are inserted before `[model.*]` overrides, so users retain normal control
+//! over every field while remote entries keep priority on key collisions.
+
+use super::{ApiBackend, AuthScheme, ModelEntry, ModelInfo};
+use indexmap::IndexMap;
+use std::num::NonZeroU64;
+use xai_grok_sampling_types::{ReasoningEffort, ReasoningEffortOption};
+
+const OPENAI_CODEX_BASE_URL: &str = "https://chatgpt.com/backend-api/codex";
+const ANTHROPIC_MESSAGES_BASE_URL: &str = "https://api.anthropic.com/v1";
+
+pub(super) fn extend_authenticated(models: &mut IndexMap<String, ModelEntry>) {
+    if crate::auth::openai_codex::read_credential().is_some() {
+        insert_missing(models, openai_entries());
+    }
+    if crate::auth::anthropic::read_credential().is_some() {
+        insert_missing(models, anthropic_entries());
+    }
+}
+
+fn insert_missing(
+    models: &mut IndexMap<String, ModelEntry>,
+    entries: impl IntoIterator<Item = (String, ModelEntry)>,
+) {
+    for (key, entry) in entries {
+        models.entry(key).or_insert(entry);
+    }
+}
+
+fn entry(
+    provider: &str,
+    slug: &str,
+    name: &str,
+    description: &str,
+    base_url: &str,
+    backend: ApiBackend,
+    auth_scheme: AuthScheme,
+    context_window: u64,
+    max_completion_tokens: Option<u32>,
+    default_effort: ReasoningEffort,
+    efforts: impl IntoIterator<Item = ReasoningEffort>,
+) -> (String, ModelEntry) {
+    let key = format!("{provider}/{slug}");
+    let mut info = ModelInfo::fallback(slug);
+    info.id = Some(key.clone());
+    info.base_url = base_url.to_owned();
+    info.name = Some(name.to_owned());
+    info.description = Some(description.to_owned());
+    info.api_backend = backend;
+    info.auth_scheme = auth_scheme;
+    info.context_window = NonZeroU64::new(context_window).expect("catalog context is non-zero");
+    info.max_completion_tokens = max_completion_tokens;
+    info.supports_reasoning_effort = true;
+    info.reasoning_effort = Some(default_effort);
+    info.reasoning_efforts = efforts
+        .into_iter()
+        .map(|value| ReasoningEffortOption {
+            id: value.to_string(),
+            value,
+            label: effort_label(value).to_owned(),
+            description: None,
+            default: value == default_effort,
+        })
+        .collect();
+
+    (
+        key,
+        ModelEntry {
+            info,
+            api_key: None,
+            env_key: None,
+            auth_provider: None,
+            api_base_url: None,
+        },
+    )
+}
+
+fn effort_label(effort: ReasoningEffort) -> &'static str {
+    match effort {
+        ReasoningEffort::Low => "Low",
+        ReasoningEffort::Medium => "Medium",
+        ReasoningEffort::High => "High",
+        ReasoningEffort::Xhigh => "Extra high",
+        ReasoningEffort::Max => "Max",
+        ReasoningEffort::None => "None",
+        ReasoningEffort::Minimal => "Minimal",
+    }
+}
+
+fn openai_entries() -> impl Iterator<Item = (String, ModelEntry)> {
+    const STANDARD_CONTEXT: u64 = 272_000;
+    const GPT_56_CONTEXT: u64 = 372_000;
+    const SPARK_CONTEXT: u64 = 128_000;
+    const MODELS: [(&str, &str, u64); 7] = [
+        (
+            "gpt-5.3-codex-spark",
+            "GPT-5.3 Codex Spark (ChatGPT)",
+            SPARK_CONTEXT,
+        ),
+        ("gpt-5.4", "GPT-5.4 (ChatGPT)", STANDARD_CONTEXT),
+        ("gpt-5.4-mini", "GPT-5.4 mini (ChatGPT)", STANDARD_CONTEXT),
+        ("gpt-5.5", "GPT-5.5 (ChatGPT)", STANDARD_CONTEXT),
+        ("gpt-5.6-luna", "GPT-5.6 Luna (ChatGPT)", GPT_56_CONTEXT),
+        ("gpt-5.6-sol", "GPT-5.6 Sol (ChatGPT)", GPT_56_CONTEXT),
+        ("gpt-5.6-terra", "GPT-5.6 Terra (ChatGPT)", GPT_56_CONTEXT),
+    ];
+
+    MODELS.into_iter().map(|(slug, name, context_window)| {
+        let mut efforts = vec![
+            ReasoningEffort::Low,
+            ReasoningEffort::Medium,
+            ReasoningEffort::High,
+            ReasoningEffort::Xhigh,
+        ];
+        if slug.starts_with("gpt-5.6") {
+            efforts.push(ReasoningEffort::Max);
+        }
+        entry(
+            "openai-codex",
+            slug,
+            name,
+            "OpenAI Codex via ChatGPT plan",
+            OPENAI_CODEX_BASE_URL,
+            ApiBackend::Responses,
+            AuthScheme::ChatgptOauth,
+            context_window,
+            None,
+            ReasoningEffort::Medium,
+            efforts,
+        )
+    })
+}
+
+fn anthropic_entries() -> impl Iterator<Item = (String, ModelEntry)> {
+    const CONTEXT: u64 = 1_000_000;
+    const MODELS: [(&str, &str, u32, bool); 6] = [
+        (
+            "claude-opus-4-8",
+            "Claude Opus 4.8 (Anthropic)",
+            128_000,
+            true,
+        ),
+        (
+            "claude-opus-4-7",
+            "Claude Opus 4.7 (Anthropic)",
+            128_000,
+            true,
+        ),
+        (
+            "claude-opus-4-6",
+            "Claude Opus 4.6 (Anthropic)",
+            128_000,
+            false,
+        ),
+        (
+            "claude-sonnet-5",
+            "Claude Sonnet 5 (Anthropic)",
+            128_000,
+            true,
+        ),
+        (
+            "claude-sonnet-4-6",
+            "Claude Sonnet 4.6 (Anthropic)",
+            64_000,
+            false,
+        ),
+        (
+            "claude-fable-5",
+            "Claude Fable 5 (Anthropic)",
+            128_000,
+            true,
+        ),
+    ];
+
+    MODELS
+        .into_iter()
+        .map(|(slug, name, max_completion_tokens, has_native_xhigh)| {
+            let mut efforts = vec![
+                ReasoningEffort::Low,
+                ReasoningEffort::Medium,
+                ReasoningEffort::High,
+            ];
+            if has_native_xhigh {
+                efforts.push(ReasoningEffort::Xhigh);
+            }
+            efforts.push(ReasoningEffort::Max);
+            entry(
+                "anthropic",
+                slug,
+                name,
+                "Anthropic Claude via Claude Pro/Max plan",
+                ANTHROPIC_MESSAGES_BASE_URL,
+                ApiBackend::Messages,
+                AuthScheme::AnthropicOauth,
+                CONTEXT,
+                Some(max_completion_tokens),
+                ReasoningEffort::High,
+                efforts,
+            )
+        })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn openai_catalog_routes_to_chatgpt_responses() {
+        let entries: Vec<_> = openai_entries().collect();
+        assert_eq!(entries.len(), 7);
+        for (key, entry) in entries {
+            let slug = key.strip_prefix("openai-codex/").expect("provider prefix");
+            assert_eq!(entry.info.id.as_deref(), Some(key.as_str()));
+            assert_eq!(entry.info.model, slug);
+            assert_eq!(entry.info.base_url, OPENAI_CODEX_BASE_URL);
+            assert_eq!(entry.info.api_backend, ApiBackend::Responses);
+            assert_eq!(entry.info.auth_scheme, AuthScheme::ChatgptOauth);
+            assert_eq!(
+                entry
+                    .info
+                    .reasoning_efforts
+                    .iter()
+                    .any(|option| option.value == ReasoningEffort::Max),
+                slug.starts_with("gpt-5.6")
+            );
+        }
+    }
+
+    #[test]
+    fn anthropic_catalog_routes_to_oauth_messages() {
+        let entries: Vec<_> = anthropic_entries().collect();
+        assert_eq!(entries.len(), 6);
+        for (key, entry) in entries {
+            let slug = key.strip_prefix("anthropic/").expect("provider prefix");
+            assert_eq!(entry.info.id.as_deref(), Some(key.as_str()));
+            assert_eq!(entry.info.model, slug);
+            assert_eq!(entry.info.base_url, ANTHROPIC_MESSAGES_BASE_URL);
+            assert_eq!(entry.info.api_backend, ApiBackend::Messages);
+            assert_eq!(entry.info.auth_scheme, AuthScheme::AnthropicOauth);
+            assert!(
+                entry
+                    .info
+                    .reasoning_efforts
+                    .iter()
+                    .any(|option| option.value == ReasoningEffort::Max)
+            );
+            let native_xhigh = matches!(
+                slug,
+                "claude-opus-4-8" | "claude-opus-4-7" | "claude-sonnet-5" | "claude-fable-5"
+            );
+            assert_eq!(
+                entry
+                    .info
+                    .reasoning_efforts
+                    .iter()
+                    .any(|option| option.value == ReasoningEffort::Xhigh),
+                native_xhigh
+            );
+        }
+    }
+
+    #[test]
+    fn insertion_never_replaces_an_existing_entry() {
+        let mut models = IndexMap::new();
+        let (key, mut existing) = openai_entries().next().expect("entry");
+        existing.info.name = Some("remote wins".to_owned());
+        models.insert(key.clone(), existing);
+        insert_missing(&mut models, openai_entries());
+        assert_eq!(models[&key].info.name.as_deref(), Some("remote wins"));
+    }
+}
