@@ -536,4 +549,50 @@ mod tests {
                 .current_model_accepts_images()
         );
     }
+
+    #[test]
+    fn max_and_xhigh_fall_back_to_the_strongest_offered_neighbor() {
+        let xhigh_id = acp::ModelId::new(Arc::from("openai-codex/gpt-test"));
+        let max_id = acp::ModelId::new(Arc::from("anthropic/claude-test"));
+        let mut state = ModelState::default();
+        state.available.insert(
+            xhigh_id.clone(),
+            acp::ModelInfo::new(xhigh_id.clone(), "OpenAI".to_string()).meta(Some(
+                serde_json::json!({
+                    "supportsReasoningEffort": true,
+                    "reasoningEfforts": [
+                        {"id": "high", "value": "high", "label": "High"},
+                        {"id": "xhigh", "value": "xhigh", "label": "Extra high"}
+                    ]
+                })
+                .as_object()
+                .expect("object")
+                .clone(),
+            )),
+        );
+        state.available.insert(
+            max_id.clone(),
+            acp::ModelInfo::new(max_id.clone(), "Anthropic".to_string()).meta(Some(
+                serde_json::json!({
+                    "supportsReasoningEffort": true,
+                    "reasoningEfforts": [
+                        {"id": "high", "value": "high", "label": "High"},
+                        {"id": "max", "value": "max", "label": "Max"}
+                    ]
+                })
+                .as_object()
+                .expect("object")
+                .clone(),
+            )),
+        );
+
+        assert_eq!(
+            state.resolve_effort_token_for(&xhigh_id, "max"),
+            Some(ReasoningEffort::Xhigh)
+        );
+        assert_eq!(
+            state.resolve_effort_token_for(&max_id, "xhigh"),
+            Some(ReasoningEffort::Max)
+        );
+    }
 }
