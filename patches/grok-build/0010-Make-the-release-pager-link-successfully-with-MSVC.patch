From 639cea1eb05137d9fec820d0acdadda999b3c673 Mon Sep 17 00:00:00 2001
From: grok-build-providers-verify <verify@invalid>
Date: Mon, 20 Jul 2026 16:56:01 +0800
Subject: [PATCH 10/16] Make the release pager link successfully with MSVC

Disable final-link PDB generation for both MSVC targets. The pager exceeds link.exe's PDB public-symbol limit even with release debug info disabled; release archives do not ship a PDB, while forced unwind tables retain panic backtraces.
---
 .cargo/config.toml | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/.cargo/config.toml b/.cargo/config.toml
index 912e93e..e365af4 100644
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -59,10 +59,21 @@ rustflags = [
 ]
 
 [target.x86_64-pc-windows-msvc]
-rustflags = ["-C", "force-unwind-tables=yes", "-C", "target-feature=+crt-static"]
+rustflags = [
+    "-C", "force-unwind-tables=yes",
+    "-C", "target-feature=+crt-static",
+    # The pager exceeds MSVC's PDB public-symbol limit (LNK4319) even when
+    # release debug info is disabled. Release artifacts do not ship a PDB;
+    # unwind tables above still preserve panic backtraces.
+    "-C", "link-arg=/DEBUG:NONE",
+]
 
 [target.aarch64-pc-windows-msvc]
-rustflags = ["-C", "force-unwind-tables=yes", "-C", "target-feature=+crt-static"]
+rustflags = [
+    "-C", "force-unwind-tables=yes",
+    "-C", "target-feature=+crt-static",
+    "-C", "link-arg=/DEBUG:NONE",
+]
 
 
 # jemalloc page size for Apple Silicon (macOS aarch64 uses 16KB pages = 2^14).
-- 
2.52.0.windows.1

