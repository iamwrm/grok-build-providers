From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: grok-build-providers-verify <verify@invalid>
Date: Tue, 1 Sep 2026 10:29:36 +0000
Subject: [PATCH 5/9] Keep patched builds portable on Windows

Skip the Unix-only protoc dependency-hint helper on Windows, and disable final-link PDB generation for MSVC release binaries to avoid link.exe public-symbol exhaustion while retaining unwind tables.
---
 .cargo/config.toml                      | 15 +++++++++++++--
 crates/build/xai-proto-build/src/lib.rs | 10 ++++++++++
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/.cargo/config.toml b/.cargo/config.toml
index 912e93e0..e365af4d 100644
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -59,10 +59,21 @@ rustflags = [
 ]
 
 [target.x86_64-pc-windows-msvc]
-rustflags = ["-C", "force-unwind-tables=yes", "-C", "target-feature=+crt-static"]
+rustflags = [
+    "-C", "force-unwind-tables=yes",
+    "-C", "target-feature=+crt-static",
+    # The pager exceeds MSVC's PDB public-symbol limit (LNK4319) even when
+    # release debug info is disabled. Release artifacts do not ship a PDB;
+    # unwind tables above still preserve panic backtraces.
+    "-C", "link-arg=/DEBUG:NONE",
+]
 
 [target.aarch64-pc-windows-msvc]
-rustflags = ["-C", "force-unwind-tables=yes", "-C", "target-feature=+crt-static"]
+rustflags = [
+    "-C", "force-unwind-tables=yes",
+    "-C", "target-feature=+crt-static",
+    "-C", "link-arg=/DEBUG:NONE",
+]
 
 
 # jemalloc page size for Apple Silicon (macOS aarch64 uses 16KB pages = 2^14).
diff --git a/crates/build/xai-proto-build/src/lib.rs b/crates/build/xai-proto-build/src/lib.rs
index 9404ea49..560f8b1f 100644
--- a/crates/build/xai-proto-build/src/lib.rs
+++ b/crates/build/xai-proto-build/src/lib.rs
@@ -132,6 +132,16 @@ impl XaiProtoBuilder {
         protos: impl IntoIterator<Item = &'a Path>,
         includes: impl IntoIterator<Item = &'a Path>,
     ) -> anyhow::Result<()> {
+        // The `--dependency_out=/dev/stdout` / `--descriptor_set_out=/dev/null`
+        // invocation below is unix-only: protoc.exe cannot open device paths on
+        // Windows, and porting the dependency-file parsing would have to cope
+        // with drive-letter colons in the `target:` prefix. The emitted
+        // `rerun-if-changed` hints only speed up incremental local rebuilds,
+        // so skip them on Windows instead (CI/release builds are clean builds).
+        if cfg!(windows) {
+            return Ok(());
+        }
+
         let includes = Vec::from_iter(includes);
 
         if let Some(protoc) = protoc {
