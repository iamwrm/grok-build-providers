+#[test]
+fn encode_and_split_responses_tool_call_ids() {
+    assert_eq!(
+        encode_responses_tool_call_id("call_1", Some("fc_2")),
+        "call_1|fc_2"
+    );
+    assert_eq!(encode_responses_tool_call_id("call_1", None), "call_1");
+    assert_eq!(
+        responses_tool_call_parts("call_1|fc_2"),
+        ("call_1", Some("fc_2"))
+    );
+    assert_eq!(responses_tool_call_parts("call_1"), ("call_1", None));
+}
