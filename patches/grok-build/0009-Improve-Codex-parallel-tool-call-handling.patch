+                // Futures still execute concurrently, but results are forwarded
+                // in assistant source order so history replay stays deterministic.
+                let mut next_source_idx = 0usize;
+                let mut pending = std::collections::BTreeMap::new();
+                while let Some((idx, result, duration_ms)) = dispatch_stream.next().await {
+                    pending.insert(idx, (result, duration_ms));
+                    while let Some((result, duration_ms)) = pending.remove(&next_source_idx) {
+                        if dispatch_tx
+                            .send((next_source_idx, result, duration_ms))
+                            .is_err()
